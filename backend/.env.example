# AI Provider: groq | huggingface | openai | openai_compatible
AI_PROVIDER=groq

# Groq (recommended - fast, free tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face Inference Providers (uses monthly credits)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-compatible endpoint (OpenRouter, Together, Ollama, LM Studio,
# Hugging Face router, DemonRoute, ...). Set AI_PROVIDER=openai_compatible.
OPENAI_COMPATIBLE_NAME=OpenRouter
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=your_key_here
OPENAI_COMPATIBLE_MODEL=qwen/qwen-2.5-coder-32b-instruct

# /execute runs user code on the server. Keep false unless sandboxed.
ENABLE_CODE_EXECUTION=false

# Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
